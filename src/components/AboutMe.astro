---
const personalImageAlt = 'Brayan Zavala';

const ejemplo = {
    descripcion: `
import React, { useState, useEffect } from 'react';
import axios from 'axios';
import "./App.css";

const Home = () => {
  const [data, setData] = useState([]);
  const [show, setShow] = useState(false);
  const [rating, setRating] = useState(1);

  useEffect(() => {
    handleGetData();
  }, []);

  const handleGetData = async () => {
    try {
      const response = await axios.get("http://localhost:8001/courses/get");
      setData(response.data);
      setShow(true);
    } catch (error) {
      console.error("Error fetching data", error);
    }
  };

  const handleApply = async (id) => {
    try {
      const response = await axios.post(\`http://localhost:8001/courses/enroll/\${id}\`);
      alert(response.data.message);
      handleGetData();
    } catch (error) {
      console.error("Error applying course", error);
    }
  };

  const handleRatingChange = (e) => {
    setRating(e.target.value);
  };

  const handleAddRating = async (id) => {
    try {
      const response = await axios.patch(\`http://localhost:8001/courses/rating/\${id}\`, {
        rating: rating
      });
      alert(response.data.message);
      handleGetData();
    } catch (error) {
      console.error("Error adding rating", error);
    }
  };

  const handleDrop = async (id) => {
    try {
      const response = await axios.delete(\`http://localhost:8001/courses/drop/\${id}\`);
      alert(response.data.message);
      handleGetData();
    } catch (error) {
      console.error("Error dropping course", error);
    }
  };

  return (
    <div className="home">
      <header>
        <h2>ABC Learning</h2>
      </header>

      {!show || !data.length ? "Fetching DATA" : (
        data.map((course, index) => (
          <div className="cardContainer" key={index}>
            <div className="card">
              <ul>
                <div className="header">
                  <li>{course.courseName}</li>
                  <li>{course.courseDept}</li>
                  <li>{course.description}</li>
                  {course.isApplied ? (
                    <li>
                      {!course.isRated && (
                        <li>
                          Rate:
                          <select
                            className="rating"
                            name="rating"
                            value={rating}
                            onChange={handleRatingChange}
                          >
                            {[1, 2, 3, 4, 5].map((val) => (
                              <option key={val} value={val}>{val}</option>
                            ))}
                          </select>
                          <button className="rate" onClick={() => handleAddRating(course._id)}>Add</button>
                        </li>
                      )}
                      <button className="drop" onClick={() => handleDrop(course._id)}>Drop Course</button>
                    </li>
                  ) : (
                    <li>
                      <button className="btn" onClick={() => handleApply(course._id)}>Apply</button>
                    </li>
                  )}
                </div>
                <div className="footer">
                  <li>{course.duration} hrs . {course.noOfRatings} Ratings . {course.rating}/5</li>
                </div>
              </ul>
            </div>
          </div>
        ))
      )}
    </div>
  );
};

export default Home;
`,
};
---

<article
    class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row"
>
    <div
        class="[&>p]:mb-4 [&>p>strong]:text-yellow-500 dark:[&>p>strong]:text-yellow-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1"
    >
        <p>
            I am Brayan Zavala, a passionate and committed developer with a
            solid background in web and mobile development. My professional
            career has focused on creating innovative and efficient digital
            tools, <strong
                >always seeking the perfect balance between functionality and
                design.
            </strong>
        </p>

        <p>
            Throughout my career, I have worked on various projects that have
            allowed me to develop skills in multiple languages and technologies.
            I have experience with tools like TypeScript, JavaScript and
            frameworks like React for frontend development. In the backend, I am
            proficient in Node.js, Java, and C#,
            <strong>
                enabling me to create comprehensive and robust solutions.</strong
            >
        </p>

        <p>
            My projects are often distinguished by their focus on performance
            and optimization, ensuring a fast and smooth experience for end
            users. I believe in the importance of teamwork and collaboration,
            actively participating with development teams.
            <!-- 
                <strong
                    >I am currently seeking new opportunities <em class="italic"
                        >to apply my knowledge and continue learning,</em
                    >
                </strong> contributing to the development of technological solutions
                that make a difference.
            -->
        </p>
        <p>
            {ejemplo.descripcion}
        </p>
    </div>

    <img
        width="200"
        height="200"
        src="/brayan-zavala.jpg"
        alt={personalImageAlt}
        class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-1 ring-black/70 dark:ring-white/20"
        style="object-position: 50% 50%"
    />
</article>
