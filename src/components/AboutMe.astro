---
const personalImageAlt = 'Brayan Zavala';

const ejemplo = {
    d1: `LOAD CSV WITH HEADERS FROM "file:///products.csv" As line
CREATE(:Product {unitPrice: toFloat(line.unitPrice), unitsInStock: toInteger(line.unitsInStock),unitsOnOrder: toInteger(line.unitsOnOrder),reorderLevel: toInteger(line.reorderLevel)}) RETURN COUNT(*);`,

    d2: `LOAD CSV WITH HEADERS FROM "http://data.neo4j.com/northwind/customers.csv" as line
CREATE(:Customer {customerID: line.customerID,companyName:line.companyName,contactName:line.contactName,contactTitle: line.contactTitle,address:line.address, city: line.city,region:line.region,postalCode:line.postalCode,country:line.country,phone: line.phone, fax:line.fax }) RETURN COUNT(*);

LOAD CSV WITH HEADERS FROM "http://data.neo4j.com/northwind/orders.csv" as line
CREATE(:Order{orderID:line.orderID,customerID:line.customerID,employeeID:line.employeeID,orderDate:line.orderDate,requiredDate:line.requiredDate,shippedDate:line.shippedDate,shipVia:line.shipVia,freight:line.freight,shipName:line.shipName,shipAddress:line.shipAddress,shipCity:line.shipCity,shipRegion:line.shipRegion,shipPostalCode:line.shipPostalCode,shipCountry:line.shipCountry}) RETURN COUNT(*);`,

    d3: `LOAD CSV WITH HEADERS FROM "http://data.neo4j.com/northwind/order-details.csv" As line
        CREATE (o)-[:ORDERS {quantity:toInteger(line.quantity)}]->(p)`,

    d4: `MATCH (cust:Customer)-[:PURCHASED]->(:Order)-[o:ORDERS]->(p:Product) WITH cust as cust, SUM(o.quantity) AS TotalProductsPurchased
WHERE TotalProductsPurchased > 1000
SET cust:Top_Customer`,
    descripcion: `LOAD CSV WITH HEADERS FROM "http://data.neo4j.com/northwind/orders.csv" AS line
CREATE (:Order {
    orderID: toInteger(line.orderID),
    customerID: line.customerID,
    employeeID: toInteger(line.employeeID),
    orderDate: date(line.orderDate),
    requiredDate: date(line.requiredDate),
    shippedDate: CASE WHEN line.shippedDate = "" THEN null ELSE date(line.shippedDate) END,
    shipVia: toInteger(line.shipVia),
    freight: toFloat(line.freight),
    shipName: line.shipName,
    shipAddress: line.shipAddress,
    shipCity: line.shipCity,
    shipRegion: CASE WHEN line.shipRegion = "" THEN null ELSE line.shipRegion END,
    shipPostalCode: line.shipPostalCode,
    shipCountry: line.shipCountry
});
`,
};
---

<article
    class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row"
>
    <div
        class="[&>p]:mb-4 [&>p>strong]:text-yellow-500 dark:[&>p>strong]:text-yellow-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1"
    >
        <p>
            I am Brayan Zavala, a passionate and committed developer with a
            solid background in web and mobile development. My professional
            career has focused on creating innovative and efficient digital
            tools, <strong
                >always seeking the perfect balance between functionality and
                design.
            </strong>
        </p>

        <p>
            Throughout my career, I have worked on various projects that have
            allowed me to develop skills in multiple languages and technologies.
            I have experience with tools like TypeScript, JavaScript and
            frameworks like React for frontend development. In the backend, I am
            proficient in Node.js, Java, and C#,
            <strong>
                enabling me to create comprehensive and robust solutions.</strong
            >
        </p>

        <p>
            My projects are often distinguished by their focus on performance
            and optimization, ensuring a fast and smooth experience for end
            users. I believe in the importance of teamwork and collaboration,
            actively participating with development teams.
            <!-- 
                <strong
                    >I am currently seeking new opportunities <em class="italic"
                        >to apply my knowledge and continue learning,</em
                    >
                </strong> contributing to the development of technological solutions
                that make a difference.
            -->
        </p>
        <p>
            {ejemplo.d1}
            <br />
            <br />
            <br />
            {ejemplo.d2}
            <br />
            <br />
            <br />
            {ejemplo.d3}
            <br />
            <br />
            <br />
            {ejemplo.d4}
            <br />
            <br />
            <br />
            {ejemplo.descripcion}
        </p>
    </div>

    <img
        width="200"
        height="200"
        src="/brayan-zavala.jpg"
        alt={personalImageAlt}
        class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-1 ring-black/70 dark:ring-white/20"
        style="object-position: 50% 50%"
    />
</article>
